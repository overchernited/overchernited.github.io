---
import Layout from "../../layouts/Layout.astro";
import TechCard from "../../components/TechCard/index.astro";
import { useTranslations, type Locale, locales } from "../../i18n";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const _ = useTranslations(locale);
---

<Layout
  title={_("seo.technologies.title")}
  description={_("seo.technologies.description")}
  locale={locale}
>
  <div
    class="parallax text-white min-h-screen w-screen flex flex-col items-center gap-16 py-10"
  >
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-base text-indigo-300/80">
        {_("technologies.cat")}
      </p>
      <h2 class="text-balance text-3xl font-extrabold leading-tight tracking-[0.06em] text-white md:text-5xl">
        {_("technologies.title")}
      </h2>
    </div>

    <div
      class="grid w-full max-w-6xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 xl:grid-cols-3"
    >
      <TechCard techname="Solid.js" rating={4} level="ADVANCED" href="https://www.solidjs.com/" locale={locale} icon="solid" />
      <TechCard techname="React.js" rating={3} level="MID" href="https://react.dev/" locale={locale} icon="react" />
      <TechCard techname="Next.js" rating={3} level="MID" href="https://nextjs.org/" locale={locale} icon="next" />
      <TechCard techname="Astro.js" rating={2} level="BEGINNER" href="https://astro.build/" locale={locale} icon="astro" />
      <TechCard techname="Tailwind" rating={3} level="MID" href="https://tailwindcss.com/" locale={locale} icon="tailwind" />
      <TechCard techname="Supabase" rating={3} level="MID" href="https://supabase.com/" locale={locale} icon="supabase" />
      <TechCard techname="Godot" rating={2} level="BEGINNER" href="https://godotengine.org/" locale={locale} icon="godot" />
    </div>

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-base text-indigo-300/80">$ cat agents.md</p>
      <h2 class="text-balance text-3xl font-extrabold leading-tight tracking-[0.06em] text-white md:text-4xl">
        {_("technologies.agentic")}
      </h2>
    </div>

    <div
      class="grid w-full max-w-6xl grid-cols-1 gap-6 px-4 pb-10 sm:grid-cols-2 xl:grid-cols-3"
    >
      <TechCard techname="Opencode" rating={4} level="ADVANCED" href="https://opencode.ai" locale={locale} icon="opencode" />
      <TechCard techname="GitHub Copilot" rating={2} level="BEGINNER" href="https://github.com/features/copilot" locale={locale} icon="copilot" />
      <TechCard techname="AI Agents & Skills" rating={3} level="MID" href="https://github.com/overchernited" locale={locale} icon="agents" />
    </div>
  </div>
</Layout>

<script>
  import gsap from "gsap";

  window.addEventListener("DOMContentLoaded", () => {

    gsap.set(".card", { autoAlpha: 0 });

    gsap.to(
      ".card",
      {
        autoAlpha: 1,
        duration: 0.5,
        stagger: 0.15,
        ease: "power2.out",
        delay: 0.1,
      },
    );
  });
</script>
