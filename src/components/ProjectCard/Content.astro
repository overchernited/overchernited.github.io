---
interface Props {
  img: string;
  title: string;
  description: string;
  tags: string[];
}

const { img, title, description, tags } = Astro.props as Props;


import Tooltip from "../Tooltip/index.astro";
---

<div class="flex w-full h-full flex-col items-center overflow-hidden rounded-3xl text-white">
  <img
    src={img}
    alt={`${title} image`}
    class="h-35 w-35 my-2 object-cover transition-transform duration-500"
  />

  <div class="flex w-full flex-1 flex-col gap-5 p-5 md:p-6 bg-white/5 rounded-2xl">
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-2">
        <p
          class="title text-xs font-bold uppercase tracking-[0.35em] text-indigo-300/80"
        >
          Project
        </p>
        <h2
          class="text-[clamp(1.35rem,2.5vw,2rem)] font-extrabold leading-tight text-white"
        >
          {title}
        </h2>
      </div>

      <Tooltip text=`Open ${title}`>
        <span
          class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-bold uppercase tracking-[0.3em] text-white/70"
        >
          Open
        </span>
      </Tooltip>
    </div>

    <p class="text-sm leading-7 text-white/75 md:text-base md:leading-8">
      {description}
    </p>

    <div class="mt-auto flex flex-col gap-4 pt-2">
      <div class="flex flex-wrap gap-2">
        {
          tags.map((tag: string) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-white/70">
              {tag}
            </span>
          ))
        }
      </div>

    </div>
  </div>
</div>
