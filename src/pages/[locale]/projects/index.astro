---
import projectsData from "../../../data/projects.json";
const projects = projectsData.projects;

import ProjectCardContent from "../../../components/ProjectCard/Content.astro";
import ProjectCard from "../../../components/ProjectCard/index.astro";
import Layout from "../../../layouts/Layout.astro";
import { useTranslations, type Locale, locales } from "../../../i18n";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const _ = useTranslations(locale);
---

<Layout
  title={_("seo.projects.title")}
  description={_("seo.projects.description")}
  locale={locale}
  footer={false}
>
  <!-- Mobile: unified card layout -->
  <div class="grid w-full grid-cols-1 gap-4 px-4 py-5 sm:grid-cols-2 lg:hidden">
    {
      projects.map((p) => (
        <a href={`/${locale}/projects/${p.id}`} class="block h-[26rem] w-full">
          <ProjectCardContent
            img={p.icon}
            title={p.title}
            description={p.description}
            tags={p.tags}
          />
        </a>
      ))
    }
  </div>

  <!-- Desktop: draggable board -->
  <div id="board" class="hidden md:relative md:overflow-hidden md:w-screen md:block md:h-dvh">
    <p
      class="drag-hint pointer-events-none absolute top-24 left-1/2 z-10 -translate-x-1/2 select-none rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-white/60 backdrop-blur"
    >
      <span class="mr-2 inline-block" aria-hidden="true">↔</span>
      {_("projects.dragHint")}
    </p>
    {
      projects.map((p) => (
        <ProjectCard
          img={p.icon}
          title={p.title}
          description={p.description}
          top={p.top}
          left={p.left}
          slug={`/${locale}/projects/${p.id}`}
          tags={p.tags}
        />
      ))
    }
  </div>
</Layout>

<script>
  import gsap from "gsap";
  import Draggable from "gsap/Draggable";

  gsap.registerPlugin(Draggable);

  const win = window as unknown as Window & { isDesktop: boolean };

  function initDesktop(): void {
    if (!win.isDesktop) return;

    let lastX = 0;
    let lastY = 0;
    let vx = 0;
    let vy = 0;

    window.addEventListener("DOMContentLoaded", () => {
      gsap.fromTo(
        ".card",
        { scale: 0 },
        {
          scale: 1,
          duration: 0.5,
          ease: "power2.out",
          stagger: 0.1,
          delay: 0.2,
        },
      );

      gsap.to(".drag-hint", {
        y: 6,
        duration: 1.2,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut",
      });
    });

    Draggable.create(".card", {
      type: "x,y",
      onPress: function () {
        lastX = this.x;
        lastY = this.y;
        gsap.killTweensOf(this.target);
      },
      onDrag: function () {
        vx = this.x - lastX;
        vy = this.y - lastY;
        lastX = this.x;
        lastY = this.y;
      },
      onDragEnd: function () {
        gsap.to(this.target, {
          x: `+=${vx * 5}`,
          y: `+=${vy * 5}`,
          duration: 0.8,
          ease: "power2.out",
          overwrite: "auto",
        });

        vx = 0;
        vy = 0;
      },
    });

    const cards = document.querySelectorAll(".card") as NodeListOf<HTMLElement>;

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        cards.forEach((c) => {
          if (c !== card) c.style.opacity = "0.5";
        });
      });

      card.addEventListener("mouseleave", () => {
        cards.forEach((c) => {
          c.style.opacity = "1";
        });
      });
    });
  }

  if (win.isDesktop !== undefined) {
    initDesktop();
  } else {
    window.addEventListener("DOMContentLoaded", initDesktop);
  }
</script>
