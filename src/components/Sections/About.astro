---
import Currently from "./Currently.astro";
import StatCard from "./StatCard.astro";
import Studies from "./Studies.astro";
---

<section
  class="mx-auto flex w-full max-w md:max-w-[80%] flex-col gap-10 px-6 py-10 text-white lg:px-10"
>
  <div class="sequence opacity-0 text-lg text-indigo-300">
    <pre>$ cat about.md</pre>
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-[1.25fr_0.85fr] lg:gap-20">
    <div class="flex flex-col gap-6">
      <h2 class="title max-w-4xl text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold leading-[0.92] md:text-left">
        Building ideas.
        <br />
        Solving problems.
        <br />
        Creating impact.
      </h2>

      <p class="sequence max-w-3xl text-justify text-[clamp(1rem,2vw,1.2rem)] leading-8 text-white/85 md:text-left">
        I’m a frontend developer from Colombia passionate about building useful,
        intuitive and visually engaging web experiences. I love turning complex
        ideas into simple solutions through clean code, good design and constant
        learning.
      </p>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div class="relative h-80 w-80 rounded-full bg-[radial-gradient(circle_at_center,rgba(168,85,247,0.2),transparent_62%)] p-10 md:h-96 md:w-96">
        <div class="absolute inset-0 rounded-full bg-[radial-gradient(circle,rgba(168,85,247,0.18)_1px,transparent_1px)] bg-size-[10px_10px] opacity-70"></div>
        <img
          src="/images/self.png"
          width={420}
          height={420}
          alt="Marlon Pixelart"
          class="relative z-10 h-full w-full object-contain"
        />
      </div>
    </div>
  </div>

  <div class="grid gap-0 overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-2xl shadow-black/20 md:grid-cols-4">
    <StatCard
      icon="▣"
      title="AGE"
      description="18 years old"
    />

    <StatCard
      icon="◉"
      title="LOCATION"
      description="Bogotá, Colombia"
      divider={true}
    />

    <StatCard
      icon="▱"
      title="EDUCATION"
      description="Software Engineering Student"
      subtitle="@ Compensar"
      divider={true}
    />

    <StatCard
      icon="➤"
      title="FOCUS"
      description="Frontend Development"
      subtitle="Web · Hardware · Games"
      divider={true}
    />
  </div>

  <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
    <Currently />
    <Studies />
  </div>
</section>
