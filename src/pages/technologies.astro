---
import Layout from "../layouts/Layout.astro";
import TechCard from "../components/TechCard/index.astro";
---

<Layout>
  <div
    class="parallax text-white min-h-screen w-screen flex flex-col items-center justify-center content-center flex-wrap gap-8 py-10"
  >
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-base font-bold tracking-[0.35em] text-indigo-300/80">
        $ cat techstack.md
      </p>
      <h2 class="text-balance text-3xl font-extrabold leading-tight tracking-[0.06em] text-white md:text-5xl">
        Tech stack
      </h2>
    </div>

    <div
      class="grid w-full max-w-6xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 xl:grid-cols-3"
    >
      <TechCard techname="Solid.js" rating={4} level="ADVANCED" href="https://www.solidjs.com/" />
      <TechCard techname="React.js" rating={3} level="MID" href="https://react.dev/" />
      <TechCard techname="Next.js" rating={3} level="MID" href="https://nextjs.org/" />
      <TechCard techname="Astro.js" rating={2} level="BEGINNER" href="https://astro.build/" />
      <TechCard techname="Tailwind" rating={3} level="MID" href="https://tailwindcss.com/" />
      <TechCard techname="Supabase" rating={3} level="MID" href="https://supabase.com/" />
      <TechCard techname="Godot" rating={2} level="BEGINNER" href="https://godotengine.org/" />
    </div>
  </div>
</Layout>

<script>
  import gsap from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    gsap.fromTo(
      ".card",
      { opacity: 0 },
      {
        opacity: 1,
        duration: 0.5,
        ease: "power2.out",
        stagger: 0.1,
        delay: 0.2,
      },
    );
  });
</script>
