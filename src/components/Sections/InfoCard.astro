---
interface Props {
  icon: string;
  title: string;
  items: string[];
}

const { icon, title, items } = Astro.props as Props;
---

<article class="flex items-start gap-4 rounded-xl border border-white/5 bg-white/5 px-6 py-5">
  <span class="mt-1 text-lg leading-none text-indigo-300">{icon}</span>
  <div class="flex flex-col gap-2">
    <span class="font-semibold text-white">{title}</span>
    {items.map((item) => <span class="text-white/70">{item}</span>)}
  </div>
</article>
