---
import Layout from "../layouts/Layout.astro";
import AboutSection from "../components/Sections/About.astro";
import Studies from "../components/Sections/Studies.astro";
import { Image } from "astro:assets";
---

<Layout
  title="About"
  description="Learn more about Marlon Hernández, his career, studies, and passion for technology and frontend development."
>
  <main
    class="parallax overflow-hidden flex flex-col justify-center items-center pt-20"
  >
    <AboutSection />
  </main>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const aboutSection = document.querySelector("main");

  gsap.set(".sequence", { autoAlpha: 0, y: 30 });

  gsap.to(".sequence", {
    autoAlpha: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.3,
    ease: "power2.out",
    scrollTrigger: {
      trigger: aboutSection,
      start: "top 75%",
      toggleActions: "play none none none",
    },
  });
</script>
