---
import InfoCard from "./InfoCard.astro";
import { useTranslations, type Locale } from "../../i18n";

export interface Props {
  locale?: string;
}

const { locale: rawLocale } = Astro.props;
const locale = (rawLocale as Locale) || "en";
const _ = useTranslations(locale);
---

<section class="flex flex-col gap-5">
  <h3 class="title text-3xl font-extrabold md:text-4xl">Studies</h3>
  <div class="flex flex-col gap-4 text-sm text-white/85 md:text-base">
    <InfoCard
      icon="●"
      title="Professional Technician in Software Development"
      items={['Fundación Universitaria Compensar', '2026 - Present']}
    />
    <InfoCard
      icon="●"
      title="Application and Cloud Services Development Technician"
      items={['Servicio Nacional de Aprendizaje', '2023 - 2025']}
    />
  </div>
</section>
