---
interface CardAppareance {
  img: string;
  from: string;
  title: string;
  description: string;
  link: string;
}

const { img, from, title, description, link } = Astro.props as CardAppareance;
---

<a
  href={link}
  class="group block w-full overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-2xl shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:bg-white/7 md:w-[58%]"
>
  <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="relative min-h-72 overflow-hidden bg-black/20 lg:min-h-full">
      <img
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        src={img}
        alt={title}
      />
      <div class="absolute inset-0 bg-linear-to-t from-black/35 via-transparent to-transparent"></div>
    </div>

    <div class="flex flex-col justify-between gap-6 p-6 md:p-8">
      <div class="flex flex-col gap-4">
        <p class="text-xs font-bold uppercase tracking-[0.4em] text-indigo-300/80">
          Public appearance
        </p>
        <h1 class="text-[clamp(1.5rem,3vw,2.4rem)] font-extrabold leading-tight text-white">
          {title}
        </h1>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-white/50">
          {from}
        </p>
      </div>

      <p class="text-base leading-7 text-white/80 md:text-lg md:leading-8">
        {description}
      </p>
    </div>
  </div>
</a>
