---
import ProjectCardContent from "./Content.astro";

interface ProjectCard {
  title: string;
  top: number;
  left: number;
  img: string;
  description: string;
  slug: any;
  tags: string[];
}

const { description, img, title, top, left, slug, tags } = Astro.props;
---

<a
  href={slug}
  style={`top: ${top}px; left: ${left}px;`}
  class="card absolute block max-h-24 w-[22rem] scale-0 transition-opacity duration-250"
>
  <ProjectCardContent
    img={img}
    title={title}
    description={description}
    tags={tags}
  />
</a>
