---
import Navbar from "../components/Navbar/index.astro";
import Pill from "../components/Pill/index.astro";
import Tooltip from "../components/Tooltip/index.astro";
import "../styles/global.css";
import { detectLocale, useTranslations, switchLocalePath, defaultLocale } from "../i18n";

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  locale?: string;
  footer?: boolean;
}

const {
  title,
  description,
  image = "https://overchernited.github.io/og-image.png",
  canonicalURL = Astro.url,
  locale: rawLocale,
  footer = true,
} = Astro.props;

const locale = (rawLocale as any) || detectLocale(Astro.url.pathname);
const _ = useTranslations(locale);
const siteName = "Marlon Hernández";
const fullTitle = `${title} | ${siteName}`;
const siteUrl = "https://overchernited.github.io";
const canonical = canonicalURL.toString().split("?")[0];
const otherLocale = locale === "en" ? "es" : "en";
const otherPath = switchLocalePath(Astro.url.pathname, otherLocale);
const base = import.meta.env.BASE_URL;
const techStack = ["Astro", "Tailwind CSS", "GSAP", "Lenis", "JavaScript", "opencode", "GitHub Copilot"];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="keywords" content="Marlon Hernández, frontend developer, portfolio, desarrollo web, programación" />
    <meta name="author" content="Marlon Hernández" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={`${siteUrl}${otherPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${switchLocalePath(Astro.url.pathname, defaultLocale)}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "es_ES"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <title>{fullTitle}</title>
  </head>
  <body>
    <Navbar locale={locale} />
    <slot />

    {footer && (
      <footer
        class="p-2 w-full text-center text-white flex gap-5 justify-center items-center flex-col print:hidden"
      >
        <p class="font-bold title">Marlon Hernandez 2026</p>
        <div class="*:hover:underline">
          <a href={`/${locale}/about`}>{_("nav.about")}</a>
          <a href={`/${locale}/appearances`}>{_("nav.appearances")}</a>
          <a href={`/${locale}/projects`}>{_("nav.projects")}</a>
          <a href={`/${locale}/technologies`}>{_("nav.technologies")}</a>
        </div>
        <div class="*:hover:underline">
          <a href="https://github.com/overchernited" target="_blank" rel="noopener">github</a>
          <a href={`/${locale}/cv`}>cv</a>
          <a
            href="https://www.linkedin.com/in/marlon-santiago-hern%C3%A1ndez-l%C3%B3pez-126024271/"
            target="_blank"
            rel="noopener"
          >linkedin</a
          >
          <Tooltip text={_("footer.tooltip.gmail")}>
            <a href="mailto:mmarlon.ssantiago@gmail.com">gmail</a>
          </Tooltip>
        </div>
        <div class="flex max-w-3xl flex-wrap justify-center gap-2">
          {techStack.map((tech) => (
            <Pill>{tech}</Pill>
          ))}
        </div>
      </footer>
    )}
  </body>
</html>

<script>
  import Lenis from "lenis";
  import gsap from "gsap";

  const lenis = new Lenis({
    smoothWheel: true
  });

  function raf(time: number): void {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);

  gsap.to(".title", {
    backgroundPosition: "100% center",
    duration: 1,
    repeat: -1,
    ease: "none",
    yoyo: true,
  });

  const win = window as unknown as Window & { isDesktop: boolean };
  const mql = window.matchMedia("(min-width: 768px)");
  const el = document.querySelector(".parallax");

  function onMouseMove(e: MouseEvent): void {
    if (!el) return;
    const x = (e.clientX / window.innerWidth - 0.5) * 80;
    const y = (e.clientY / window.innerHeight - 0.5) * 40;
    gsap.to(el, { x, y, duration: 0.6, ease: "power2.out" });
  }

  function setDesktop(isDesktop: boolean): void {
    win.isDesktop = isDesktop;
    if (isDesktop) {
      window.addEventListener("mousemove", onMouseMove);
    } else {
      window.removeEventListener("mousemove", onMouseMove);
      gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: "power2.out" });
    }
  }

  function onDesktopChange(e: MediaQueryListEvent): void {
    setDesktop(e.matches);
  }

  setDesktop(mql.matches);
  mql.addEventListener("change", onDesktopChange);
</script>
