---
import Layout from "../../layouts/Layout.astro";
import AboutSection from "../../components/Sections/About.astro";
import { useTranslations, type Locale, locales } from "../../i18n";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const _ = useTranslations(locale);
---

<Layout
  title={_("seo.about.title")}
  description={_("seo.about.description")}
  locale={locale}
>
  <main
    class="parallax overflow-hidden flex flex-col justify-center items-center pt-20"
  >
    <AboutSection locale={locale} />
  </main>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const aboutSection = document.querySelector("main");

  gsap.set(".sequence", { autoAlpha: 0, y: 30 });
  gsap.set(".sequence.title", { filter: "blur(4px)" });

  gsap.to(".sequence", {
    autoAlpha: 1,
    y: 0,
    filter: "blur(0px)",
    duration: 0.6,
    stagger: 0.3,
    ease: "power2.out",
    scrollTrigger: {
      trigger: aboutSection,
      start: "top 75%",
      toggleActions: "play none none none",
    },
  });
</script>
