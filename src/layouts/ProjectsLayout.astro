---
import Navbar from "../components/Navbar/index.astro";
import "../styles/global.css";
import { detectLocale, useTranslations, switchLocalePath, defaultLocale } from "../i18n";

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  locale?: string;
}

const {
  title,
  description,
  image = "https://overchernited.github.io/og-image.png",
  canonicalURL = Astro.url,
  locale: rawLocale,
} = Astro.props;

const locale = (rawLocale as any) || detectLocale(Astro.url.pathname);
const _ = useTranslations(locale);
const siteName = "Marlon Hernández";
const fullTitle = `${title} | ${siteName}`;
const siteUrl = "https://overchernited.github.io";
const canonical = canonicalURL.toString().split("?")[0];
const otherLocale = locale === "en" ? "es" : "en";
const otherPath = switchLocalePath(Astro.url.pathname, otherLocale);

---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Marlon Hernandez, frontend developer, portfolio, proyectos, desarrollo web" />
    <meta name="author" content="Marlon Hernandez" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={`${siteUrl}${otherPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${switchLocalePath(Astro.url.pathname, "en")}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "es_ES"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <title>{fullTitle}</title>
  </head>
  <body>
    <Navbar locale={locale} />
    <slot />
  </body>
</html>

<script>
  import gsap from "gsap";

  gsap.to(".title", {
    backgroundPosition: "100% center",
    duration: 1,
    repeat: -1,
    ease: "none",
    yoyo: true,
  });

  const win = window as unknown as Window & { isDesktop: boolean };
  const mql = window.matchMedia("(min-width: 768px)");
  win.isDesktop = mql.matches;
  mql.addEventListener("change", (e: MediaQueryListEvent): void => {
    win.isDesktop = e.matches;
  });
</script>
