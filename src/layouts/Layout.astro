---
import Navbar from "../components/Navbar/index.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description,
  image = "https://overchernited.github.io/og-image.png",
  canonicalURL = Astro.url,
} = Astro.props;

const siteName = "Marlon Hernández";
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="keywords" content="Marlon Hernández, frontend developer, portfolio, desarrollo web, programación" />
    <meta name="author" content="Marlon Hernández" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <title>{fullTitle}</title>
  </head>
  <body>
    <Navbar />
    <slot />

    <footer
      class="p-2 w-full text-center text-white flex gap-5 justify-center items-center flex-col"
    >
      <p class="font-bold title">Marlon Hernández 2026</p>
      <div class="*:hover:underline">
        <a href=`${import.meta.env.BASE_URL}about`>About</a>
        <a href=`${import.meta.env.BASE_URL}appearances`>Appearances</a>
        <a href=`${import.meta.env.BASE_URL}projects`>Projects</a>
        <a href=`${import.meta.env.BASE_URL}technologies`>Technologies</a>
      </div>
      <div class="*:hover:underline">
        <a>github</a>
        <a>cv</a>
        <a>linkedin</a>
        <a>gmail</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import Lenis from "lenis";
  import gsap from "gsap";

  const lenis = new Lenis({
    smoothWheel: true
  });

  function raf(time: number): void {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);

  gsap.to(".title", {
    backgroundPosition: "100% center",
    duration: 1,
    repeat: -1,
    ease: "none",
    yoyo: true,
  });

  const win = window as unknown as Window & { isDesktop: boolean };
  const mql = window.matchMedia("(min-width: 768px)");
  const el = document.querySelector(".parallax");

  function onMouseMove(e: MouseEvent): void {
    if (!el) return;
    const x = (e.clientX / window.innerWidth - 0.5) * 80;
    const y = (e.clientY / window.innerHeight - 0.5) * 40;
    gsap.to(el, { x, y, duration: 0.6, ease: "power2.out" });
  }

  function setDesktop(isDesktop: boolean): void {
    win.isDesktop = isDesktop;
    if (isDesktop) {
      window.addEventListener("mousemove", onMouseMove);
    } else {
      window.removeEventListener("mousemove", onMouseMove);
      gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: "power2.out" });
    }
  }

  function onDesktopChange(e: MediaQueryListEvent): void {
    setDesktop(e.matches);
  }

  setDesktop(mql.matches);
  mql.addEventListener("change", onDesktopChange);
</script>
