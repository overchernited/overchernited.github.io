---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="mb-6 print:mb-3.5">
  <h2
    class="mb-3.5 border-b border-slate-200 pb-1.5 text-xs font-extrabold uppercase tracking-[0.12em] text-indigo-600 print:mb-2 print:pb-1 print:text-[10.5px]"
  >
    {title}
  </h2>
  <slot />
</section>
