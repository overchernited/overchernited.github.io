---
import Currently from "./Currently.astro";
import StatCard from "./StatCard.astro";
import Studies from "./Studies.astro";
import { useTranslations, type Locale } from "../../i18n";

export interface Props {
  locale?: string;
}

const { locale: rawLocale } = Astro.props;
const locale = (rawLocale as Locale) || "en";
const _ = useTranslations(locale);
---

<section
  class="mx-auto flex w-full max-w md:max-w-[80%] flex-col gap-10 px-6 py-10 text-white lg:px-10"
>
  <div class="sequence opacity-0 text-lg text-indigo-300">
    <pre>{_("about.cat")}</pre>
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-[1.25fr_0.85fr] lg:gap-20">
    <div class="flex flex-col gap-6">
      <h2 class="max-w-4xl text-[clamp(2.5rem,7vw,4.5rem)] font-extrabold md:text-left">
        <span class="sequence title">{_("about.title1")}</span>
        <br />
        <span class="sequence title">{_("about.title2")}</span>
        <br />
        <span class="sequence title">{_("about.title3")}</span>
      </h2>

      <p class="sequence max-w-3xl text-justify text-[clamp(1rem,2vw,1.2rem)] leading-8 text-white/85 md:text-left">
        {_("about.bio")}
      </p>
    </div>

    <div class="sequence flex justify-center lg:justify-end">
      <div class="relative h-80 w-80 rounded-full bg-[radial-gradient(circle_at_center,rgba(168,85,247,0.2),transparent_62%)] p-10 md:h-96 md:w-96">
        <img
          src="/images/self.png"
          width={420}
          height={420}
          alt="Marlon Pixelart"
          class="relative z-10 h-full w-full object-contain"
        />
      </div>
    </div>

  </div>

  <div class="sequence">
    <div class="grid gap-0 overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-2xl shadow-black/20 md:grid-cols-4 hover:border-indigo-500 transition-all hover:shadow-indigo-500/30 duration-150">
      <StatCard
      icon="▣"
      title={_("about.age")}
      description={_("about.ageValue")}
      />
      
      <StatCard
      icon="◉"
      title={_("about.location")}
      description={_("about.locationValue")}
      divider={true}
      />
      
      <StatCard
      icon="▱"
      title={_("about.education")}
      description={_("about.educationValue")}
      subtitle={_("about.educationSub")}
      divider={true}
      />
      
      <StatCard
      icon="➤"
      title={_("about.focus")}
      description={_("about.focusValue")}
      subtitle={_("about.focusSub")}
      divider={true}
      />
    </div>
  </div>

  <div class="sequence grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
    <Currently locale={locale} />
    <Studies locale={locale} />
  </div>
</section>
