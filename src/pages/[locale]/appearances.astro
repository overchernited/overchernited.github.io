---
import Layout from "../../layouts/Layout.astro";
import CardAppareance from "../../components/CardAppareance/index.astro";
import { useTranslations, type Locale, locales } from "../../i18n";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const _ = useTranslations(locale);
---

<Layout
  title={_("seo.appearances.title")}
  description={_("seo.appearances.description")}
  locale={locale}
>
  <div
    class="parallax text-white min-h-screen flex flex-col justify-center items-center gap-8 px-5 py-10"
  >
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-base text-indigo-300/80">
        {_("appearances.cat")}
      </p>
      <h2 class="max-w-4xl text-balance text-3xl font-extrabold leading-tight tracking-[0.03em] text-white md:text-5xl">
        {_("appearances.title")}
      </h2>
    </div>

    <CardAppareance
      img="https://i.ytimg.com/vi/Cz9I5FzG00Y/maxresdefault.jpg"
      title={_("appearances.articleTitle")}
      from={_("appearances.articleFrom")}
      link="https://www.ilo.org/es/resource/articulo/con-el-respaldo-de-la-oit-un-joven-programador-transforma-su-pasion-por-la"
      description={_("appearances.articleDescription")}
    />
  </div>
</Layout>
