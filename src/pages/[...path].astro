---
export function getStaticPaths() {
  const projects = ["helpit", "liftio", "kat"];
  const legacyPaths = [
    "about",
    "projects",
    "appearances",
    "technologies",
    "cv",
    "resume",
    ...projects.map((p) => `projects/${p}`),
  ];
  return legacyPaths.map((path) => ({
    params: { path },
  }));
}

const { path } = Astro.params;
const cleanPath = path ? `/${path}` : "/";
const redirectUrl = `/en${cleanPath}`;
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
    <link rel="canonical" href={`https://overchernited.github.io${redirectUrl}`} />
  </head>
  <body></body>
</html>
