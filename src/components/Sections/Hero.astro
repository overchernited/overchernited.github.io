---
import Tooltip from "../Tooltip/index.astro";
import { useTranslations, type Locale } from "../../i18n";

export interface Props {
  locale?: string;
}

const { locale: rawLocale } = Astro.props;
const locale = (rawLocale as Locale) || "en";
const _ = useTranslations(locale);
---

<section
  class="text-white text-4xl flex flex-col items-center justify-center h-[85vh]"
>
  <div class="p-4 [*_&]:line parallax text-left items-start flex flex-col gap-4">
    <code
      class="prompt-line flex items-center gap-1 text-lg font-black text-white bg-indigo-600 w-fit px-2"
    >
      <span><pre class="text-white"> user@browser:~$ </pre></span>
      <span class="typed-cmd text-lg font-normal text-white"></span>
      <span class="cursor-typing text-lg text-white/70">▊</span>
    </code>

    <aside class="output-section flex flex-col">
      <code class="title font-bold text-[clamp(2.4rem,6vw,10rem)]"
        >Marlón Hernández</code
      >
      <code class="title lg:font-bold leading-none whitespace-nowrap text-[clamp(2rem,5vw,2.5rem)]"
        >Frontend Developer</code
      >
      <code class="text-gray-300 my-5 text-[clamp(1rem,5vw,1.5rem)]">
        {_("hero.tagline")}
      </code>
    </aside>

    <div class="text-center links-section flex flex-col lg:flex-row gap-4 justify-center lg:justify-between w-full items-center">
      
      <aside class="flex flex-wrap gap-x-3 gap-y-2 *:hover:underline">
        <Tooltip text={_("footer.tooltip.github")}>
          <a href="https://github.com/overchernited" class="text-xl">{_("hero.github")}</a>
        </Tooltip>
        <Tooltip text={_("footer.tooltip.resume")}>
          <a href={`/${locale}/cv`} class="text-xl">{_("hero.resume")}</a>
        </Tooltip>
        <Tooltip text={_("footer.tooltip.linkedin")}>
          <a
            href="https://www.linkedin.com/in/marlon-santiago-hern%C3%A1ndez-l%C3%B3pez-126024271/"
            class="text-xl"
            target="_blank"
            rel="noopener"
          >{_("hero.linkedin")}</a
          >
        </Tooltip>
        <Tooltip text={_("footer.tooltip.gmail")}>
          <a href="mailto:mmarlon.ssantiago@gmail.com" class="text-xl">{_("hero.gmail")}</a>
        </Tooltip>
      </aside>

      <Tooltip text={_("projects.more")}>
        <a class="gradient-button text-2xl" href={`/${locale}/projects`}>{_("hero.viewProjects")}</a>
      </Tooltip>
    </div>
    
  </div>
</section>

<script>
  import gsap from "gsap";

  const cmdText = "> whoami";

  function typeText(el: HTMLElement, text: string, duration: number) {
    el.textContent = "";
    return gsap.to({}, {
      duration,
      ease: "none",
      onUpdate: function () {
        const chars = Math.floor(this.progress() * text.length);
        el.textContent = text.substring(0, chars);
      },
      onComplete: () => {
        el.textContent = text;
      },
    });
  }

  window.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline({ delay: 0.8 });
    const cmdEl = document.querySelector(".typed-cmd") as HTMLElement;
    const cursor = document.querySelector(".cursor-typing") as HTMLElement;
    const output = document.querySelector(".output-section") as HTMLElement;
    const links = document.querySelector(".links-section") as HTMLElement;

    tl.fromTo(
      ".prompt-line",
      { opacity: 0, x: -10 },
      { opacity: 1, x: 0, duration: 0.3, ease: "power2.out" }
    )
    .add(() => typeText(cmdEl, cmdText, 0.8), "+=0.2")
    .to({}, { duration: 0.3 })
    .to(cursor, { opacity: 0, duration: 0.15 }, "+=0.1")
    .fromTo(
      output,
      { opacity: 0, y: 20, filter: "blur(4px)" },
      {
        opacity: 1,
        y: 0,
        filter: "blur(0px)",
        duration: 0.7,
        ease: "power3.out",
      }
    )
    .fromTo(
      links,
      { opacity: 0, y: 15 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power2.out",
      },
      "-=0.2"
    );
  });
</script>
