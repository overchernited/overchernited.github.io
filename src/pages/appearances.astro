---
import Layout from "../layouts/Layout.astro";
import CardAppareance from "../components/CardAppareance/index.astro";
---

<Layout
  title="Appearances"
  description="Public appearances and mentions of Marlon Hernández in media and conferences."
>
  <div
    class="parallax text-white min-h-screen flex flex-col justify-center items-center gap-8 px-5 py-10"
  >
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="text-base text-indigo-300/80">
        $ cat appearances.md
      </p>
      <h2 class="max-w-4xl text-balance text-3xl font-extrabold leading-tight tracking-[0.03em] text-white md:text-5xl">
        Public appearances and mentions
      </h2>
    </div>

    <CardAppareance
      img="https://i.ytimg.com/vi/Cz9I5FzG00Y/maxresdefault.jpg"
      title="Un joven programador transforma su pasión por la tecnología en propósito social a través de SENATIC"
      from="OIT | Senatic"
      link="https://www.ilo.org/es/resource/articulo/con-el-respaldo-de-la-oit-un-joven-programador-transforma-su-pasion-por-la"
      description="A sus 17 años, Marlon Santiago Hernández López ya mira al mundo desde el código. La tecnología no es solo su pasión temprana, sino su lenguaje para transformar realidades."
    />
  </div>
</Layout>
