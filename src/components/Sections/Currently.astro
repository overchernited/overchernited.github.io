---
import InfoCard from "./InfoCard.astro";
import { useTranslations, type Locale } from "../../i18n";

export interface Props {
  locale?: string;
}

const { locale: rawLocale } = Astro.props;
const locale = (rawLocale as Locale) || "en";
const _ = useTranslations(locale);
---

<section class="flex flex-col gap-5">
  <h3 class="title text-3xl font-extrabold md:text-4xl">Currently</h3>
  <ul class="flex flex-col gap-4 text-sm text-white/85 md:text-base">
    <InfoCard
      icon="⌁"
      title="Building web applications"
      items={['with modern technologies']}
    />
    <InfoCard
      icon="⌁"
      title="Developing personal projects"
      items={['(Mature, Liftio, KAT...)']}
    />
    <InfoCard
      icon="⌁"
      title="Experimenting with hardware"
      items={['& embedded systems (ESP32 OS)']}
    />
  </ul>
</section>
